[Desktop Entry]
Version=1.0
Type=Application
Name=Badge3D Coin Generator
GenericName=Parametric 3D Coin & Relief Studio
Comment=Zero-egress 3D coin, medallion, and relief badge workstation with PBR metallic shaders, watertight STL/OBJ/GLB export, and Marlin G-code slicing.
Exec=/usr/local/bin/badge3d-coin-generator desktop
TryExec=/usr/local/bin/badge3d-coin-generator
Icon=badge3d-coin-generator
Terminal=false
Categories=X-Zoth-Media;Development;Graphics;3DGraphics;Utility;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Badge3D Coin Generator Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Badge3D Coin Generator TUI" -- /usr/local/bin/badge3d-coin-generator-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8084)
Exec=xdg-open http://127.0.0.1:8084
