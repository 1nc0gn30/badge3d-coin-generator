#!/usr/bin/env python3
"""Badge3D Coin Generator v2.6.0 — Live Telemetry & Watertight Mesh Benchmark TUI.

Probes live http://127.0.0.1:8084/api/health and /api/presets, runs a real
CoinMeshEngine watertight 2-manifold benchmark, and reports real MCP tool count.
Supports --json for machine-readable output and interactive terminal display.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


TOOL_ID = "badge3d-coin-generator"
TOOL_NAME = "Badge3D Coin Generator"
TOOL_VERSION = "2.6.0"
DEFAULT_PORT = 8084


def _find_package_src() -> Optional[Path]:
    candidates = [
        Path("/opt/badge3d-coin-generator/src"),
        Path.home() / "NullAITech" / "badge3d-coin-generator" / "src",
        Path(__file__).resolve().parent.parent / "src",
    ]
    for cand in candidates:
        if (cand / "badge3d_coin_generator" / "__init__.py").is_file():
            return cand
    return None


def _probe_json(url: str, timeout: float = 1.5) -> Tuple[Optional[Dict[str, Any]], float]:
    t0 = time.perf_counter()
    try:
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            elapsed = round((time.perf_counter() - t0) * 1000.0, 2)
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8")), elapsed
    except Exception:
        pass
    return None, round((time.perf_counter() - t0) * 1000.0, 2)


def _run_mesh_benchmark() -> Dict[str, Any]:
    src_dir = _find_package_src()
    if src_dir is not None and str(src_dir) not in sys.path:
        sys.path.insert(0, str(src_dir))

    try:
        from badge3d_coin_generator import CoinGenerator, __version__, compute_mesh_volume
        from badge3d_coin_generator.mcp_server import TOOLS_DEFINITIONS

        t0 = time.perf_counter()
        gen = CoinGenerator(radius=20.0, thickness=3.0, serrations=60, resolution=48, field_rings=12)
        mesh = gen.generate()
        watertight = mesh.is_watertight()
        vol_mm3 = round(compute_mesh_volume(mesh), 2)
        elapsed_ms = round((time.perf_counter() - t0) * 1000.0, 2)
        return {
            "ok": True,
            "package_version": __version__,
            "triangles": mesh.triangle_count,
            "vertices": mesh.vertex_count,
            "watertight": watertight,
            "volume_mm3": vol_mm3,
            "elapsed_ms": elapsed_ms,
            "mcp_tool_count": len(TOOLS_DEFINITIONS),
            "mcp_tools": [t["name"] for t in TOOLS_DEFINITIONS],
        }
    except Exception as exc:
        return {
            "ok": False,
            "error": str(exc),
            "triangles": 0,
            "vertices": 0,
            "watertight": False,
            "elapsed_ms": 0.0,
            "mcp_tool_count": 0,
            "mcp_tools": [],
        }


def _braille_bar(ratio: float, width: int = 24) -> str:
    clamped = max(0.0, min(1.0, ratio))
    filled = int(round(clamped * width))
    return "⣿" * filled + "⣀" * (width - filled)


def collect_telemetry(port: int = DEFAULT_PORT) -> Dict[str, Any]:
    base = f"http://127.0.0.1:{port}"
    health, health_ms = _probe_json(f"{base}/api/health")
    presets_resp, presets_ms = _probe_json(f"{base}/api/presets") if health else (None, 0.0)
    bench = _run_mesh_benchmark()

    presets_list: List[str] = []
    if isinstance(presets_resp, dict) and isinstance(presets_resp.get("presets"), dict):
        presets_list = sorted(presets_resp["presets"].keys())

    return {
        "tool_id": TOOL_ID,
        "name": TOOL_NAME,
        "version": bench.get("package_version") or TOOL_VERSION,
        "endpoint": base,
        "daemon": {
            "online": health is not None,
            "status": (health or {}).get("status", "offline"),
            "version": (health or {}).get("version"),
            "latency_ms": health_ms if health else None,
            "presets_count": len(presets_list),
            "presets": presets_list,
            "presets_latency_ms": presets_ms if presets_resp else None,
        },
        "mesh_benchmark": {
            "engine": "CoinMeshEngine",
            "ok": bench["ok"],
            "triangles": bench["triangles"],
            "vertices": bench["vertices"],
            "watertight": bench["watertight"],
            "volume_mm3": bench.get("volume_mm3", 0.0),
            "elapsed_ms": bench["elapsed_ms"],
        },
        "mcp_tool_count": bench["mcp_tool_count"],
        "mcp_tools": bench["mcp_tools"],
        "attribution": "Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
    }


def render_tui(data: Dict[str, Any]) -> None:
    d = data["daemon"]
    b = data["mesh_benchmark"]
    status_badge = "\033[1;32mONLINE\033[0m" if d["online"] else "\033[1;33mOFFLINE (on-demand)\033[0m"
    mf_badge = "\033[1;32mWATERTIGHT 2-MANIFOLD\033[0m" if b["watertight"] else "\033[1;31mFAILED\033[0m"
    speed_score = min(1.0, 250.0 / max(1.0, float(b["elapsed_ms"] or 250.0)))

    print("\033[1;33m╭──────────────────────────────────────────────────────────────────────────╮\033[0m")
    print(f"\033[1;33m│\033[0m 🪙 \033[1;37m{data['name']} v{data['version']:<18}\033[0m │ \033[36m127.0.0.1:{DEFAULT_PORT} · Zero-Egress\033[0m      \033[1;33m│\033[0m")
    print("\033[1;33m├──────────────────────────────────────────────────────────────────────────┤\033[0m")
    print(f"\033[1;33m│\033[0m  Daemon Status  : {status_badge}  (latency: {d['latency_ms']} ms)")
    print(f"\033[1;33m│\033[0m  API Presets    : {d['presets_count']} live ({', '.join(d['presets'][:5]) or 'start daemon to query'})")
    print(f"\033[1;33m│\033[0m  Mesh Benchmark : {b['triangles']:,} tris · {b['vertices']:,} verts · {b['elapsed_ms']} ms")
    print(f"\033[1;33m│\033[0m  Manifold Check : {mf_badge}  {_braille_bar(speed_score)}")
    print(f"\033[1;33m│\033[0m  MCP Tools      : {data['mcp_tool_count']} registered ({', '.join(data['mcp_tools'][:4])}...)")
    print("\033[1;33m╰──────────────────────────────────────────────────────────────────────────╯\033[0m")


def main() -> None:
    parser = argparse.ArgumentParser(description="Badge3D Coin Generator Live Telemetry & Benchmark TUI")
    parser.add_argument("--json", action="store_true", help="Output live telemetry & benchmark as JSON")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help="Local daemon port (default: 8084)")
    args = parser.parse_args()

    telemetry = collect_telemetry(port=args.port)
    if args.json:
        print(json.dumps(telemetry, indent=2))
        return
    render_tui(telemetry)


if __name__ == "__main__":
    main()
