#!/usr/bin/env python3
"""Unified ZothOS & Host CLI Wrapper for Badge3D Coin Generator v2.6.0.

Resolves the installed runtime cleanly across both ZothOS ISO (/opt/badge3d-coin-generator)
and developer workspaces ($HOME/NullAITech/badge3d-coin-generator) with zero hardcoded user paths.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Dict, Optional

TOOL_ID = "badge3d-coin-generator"
TOOL_REPO = "badge3d-coin-generator"
TOOL_NAME = "Badge3D Coin Generator"
TOOL_DESC = (
    "Zero-egress 3D WebGL coin, medallion, and relief badge workstation with "
    "watertight 2-manifold Python STL/OBJ/GLB exports, Marlin G-code slicer, and 9 MCP tools."
)
TOOL_VERSION = "2.6.0"
TOOL_CATEGORY = "Media & 3D"
TOOL_PORT = 8084
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"


def resolve_repo_dir() -> Path:
    candidates = [
        Path.home() / "NullAITech" / TOOL_REPO,
        Path("/opt") / TOOL_REPO,
    ]
    for cand in candidates:
        if (cand / "src" / "badge3d_coin_generator" / "__init__.py").is_file():
            return cand
    return candidates[0]


def check_daemon() -> Optional[Dict[str, Any]]:
    for path in ("/api/health", "/health"):
        try:
            req = urllib.request.Request(f"http://127.0.0.1:{TOOL_PORT}{path}")
            with urllib.request.urlopen(req, timeout=1.5) as resp:
                if resp.status == 200:
                    return json.loads(resp.read().decode("utf-8"))
        except Exception:
            pass
    return None


def main() -> None:
    repo_dir = resolve_repo_dir()
    pkg_dir = repo_dir / "src"
    args = sys.argv[1:]

    if "--electron" in args or (args and args[0] in ("desktop", "electron")):
        rem = [a for a in args if a not in ("--electron", "desktop", "electron")]
        elec = shutil.which("electron") or "/usr/local/bin/electron"
        entry = repo_dir / "electron" / "main.cjs"
        if entry.is_file() and os.path.exists(elec):
            sys.exit(subprocess.run([elec, str(entry)] + rem, cwd=str(repo_dir)).returncode)
        # Fallback to launching the web workstation directly if Electron is absent
        args = ["serve", "--host", "127.0.0.1", "--port", str(TOOL_PORT)]

    if "--tui" in args or (args and args[0] == "tui"):
        rem = [a for a in args if a not in ("--tui", "tui")]
        tui_bin = shutil.which(f"{TOOL_ID}-tui") or f"/usr/local/bin/{TOOL_ID}-tui"
        sys.exit(subprocess.run([tui_bin] + rem).returncode)

    if args and args[0] in ("--status", "--json", "--ui"):
        daemon_status = check_daemon()
        if args[0] == "--ui":
            print(STUDIO_URL)
            return

        if args[0] == "--status":
            state = "ONLINE" if daemon_status else "OFFLINE"
            print(f"✦ {TOOL_NAME} Daemon Status: {state} (:{TOOL_PORT})")
            if daemon_status:
                print(f"  Service : {daemon_status.get('service')}")
                print(f"  Version : {daemon_status.get('version')}")
            return

        if args[0] == "--json":
            info = {
                "id": TOOL_ID,
                "repo": TOOL_REPO,
                "name": TOOL_NAME,
                "version": TOOL_VERSION,
                "category": TOOL_CATEGORY,
                "installed": pkg_dir.is_dir(),
                "repo_path": str(repo_dir),
                "native_cli": str(pkg_dir / "badge3d_coin_generator" / "cli.py"),
                "studio_workbench_url": STUDIO_URL,
                "local_endpoint": LOCAL_PORT_URL,
                "daemon_online": daemon_status is not None,
                "daemon_info": daemon_status,
                "license": "100% Free & Open Access (Zero Paywalls)",
                "support": {
                    "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
                    "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK",
                },
                "status": "READY" if pkg_dir.is_dir() else "MISSING",
            }
            print(json.dumps(info, indent=2))
            return

    if pkg_dir.is_dir():
        env = os.environ.copy()
        env["PYTHONPATH"] = str(pkg_dir) + os.pathsep + env.get("PYTHONPATH", "")
        res = subprocess.run([sys.executable, "-m", "badge3d_coin_generator.cli"] + args, cwd=str(repo_dir), env=env)
        sys.exit(res.returncode)

    print(f"Error: badge3d-coin-generator package not found in /opt or ~/NullAITech", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
